{
	"name": "wordsegmentation",
	"version": "1.0.1",
	"description": "Move, delete, and select one word at a time in languages that do not use spaces.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"spellcheck": "cspell \"src/**/*\" \"docs/**/*\" \"tests/**/*\" README.md",
		"prepare": "husky"
	},
	"keywords": [],
	"license": "MIT",
	"peerDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6"
	},
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.5",
		"@types/node": "^24.10.1",
		"cspell": "^10.3.4",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"obsidian": "latest",
		"prettier": "^3.9.9",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.70.1"
	}
}
